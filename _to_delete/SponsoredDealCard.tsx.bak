import { useEffect, useRef } from 'react';
import { View, Text, Pressable, Image, Animated, StyleSheet } from 'react-native';
import { Ionicons } from '@expo/vector-icons';
import { endsInLabel, type SponsoredDeal } from '../../hooks/useSponsoredDeal';
import { colors, spacing, radius, font, shadow, typography } from '../../theme';

/**
 * The dashboard's promo slot: one paid placement from a bookshop,
 * shown only while the buyer has nothing in checkout.
 *
 * Two layouts, one component:
 *   'column'  the right-hand rail on desktop, where Order Summary sits
 *             when there is something to pay for
 *   'inline'  a card at the top of the side column on tablet and phone
 *
 * The badge is never optional. It is paid placement, and the directory
 * card in the middle of the page ("Featured Shops & Categories") stays
 * organic precisely so the two can never be confused.
 */

interface Props {
  deal: SponsoredDeal;
  variant: 'column' | 'inline';
  onRequestQuote: (deal: SponsoredDeal) => void;
  onViewShop: (deal: SponsoredDeal) => void;
}

export function SponsoredDealCard({ deal, variant, onRequestQuote, onViewShop }: Props) {
  // Fades in, so the swap from Order Summary reads as a change of state
  // rather than a layout jump.
  const opacity = useRef(new Animated.Value(0)).current;
  useEffect(() => {
    Animated.timing(opacity, { toValue: 1, duration: 260, useNativeDriver: true }).start();
  }, [opacity, deal.deal_id]);

  const ends = endsInLabel(deal.ends_at);
  const urgent = new Date(deal.ends_at).getTime() - Date.now() < 48 * 3_600_000;

  const card = (
    <Animated.View
      style={[styles.card, variant === 'inline' && styles.cardInline, { opacity }]}
      accessibilityRole="summary"
      accessibilityLabel={`${deal.badge.toLowerCase()} deal from ${deal.store_name}: ${deal.headline}. ${ends}.`}
    >
      <View style={styles.topRow}>
        <View style={styles.badge}>
          <Ionicons name="megaphone-outline" size={11} color={colors.orangeDark} />
          <Text style={styles.badgeText}>{deal.badge}</Text>
        </View>
        <View style={[styles.timer, urgent && styles.timerUrgent]}>
          <Ionicons name="time-outline" size={11} color={urgent ? colors.danger : colors.textMuted} />
          <Text style={[styles.timerText, urgent && { color: colors.danger }]}>{ends}</Text>
        </View>
      </View>

      {deal.image_url ? (
        <Image
          source={{ uri: deal.image_url }}
          style={styles.image}
          resizeMode="cover"
          accessibilityLabel={`${deal.store_name} shop photo`}
        />
      ) : (
        <View style={styles.imageFallback} accessibilityElementsHidden importantForAccessibility="no">
          <Text style={styles.monogram}>{deal.store_name.slice(0, 1).toUpperCase()}</Text>
          <Ionicons name="storefront" size={18} color={colors.onNavyMuted} style={styles.fallbackIcon} />
        </View>
      )}

      <View style={styles.shopRow}>
        <Text style={styles.shopName} numberOfLines={1}>
          {deal.store_name}
        </Text>
        {deal.verified && <Ionicons name="checkmark-circle" size={14} color={colors.success} accessibilityLabel="Verified shop" />}
      </View>
      <Text style={styles.shopMeta} numberOfLines={1}>
        {[
          deal.city,
          deal.rating != null ? `★ ${deal.rating.toFixed(1)} (${deal.review_count})` : 'New on LOCI',
        ]
          .filter(Boolean)
          .join(' · ')}
      </Text>

      <Text style={styles.headline}>{deal.headline}</Text>
      {!!deal.audience && (
        <View style={styles.audience}>
          <Text style={styles.audienceText}>{deal.audience}</Text>
        </View>
      )}
      {!!deal.details && <Text style={styles.details}>{deal.details}</Text>}

      <Pressable
        onPress={() => onRequestQuote(deal)}
        style={({ pressed }) => [styles.cta, pressed && styles.ctaPressed]}
        accessibilityRole="button"
        accessibilityLabel={`Request a quote from ${deal.store_name}`}
      >
        <Ionicons name="paper-plane-outline" size={15} color={colors.onNavy} />
        <Text style={styles.ctaText} numberOfLines={2}>
          Request Quote from {deal.store_name}
        </Text>
      </Pressable>
      <Pressable onPress={() => onViewShop(deal)} style={styles.link} accessibilityRole="link" hitSlop={6}>
        <Text style={styles.linkText}>View shop</Text>
      </Pressable>

      <Text style={styles.fine}>
        Sponsored placement. The discount is applied by the shop on its quote — you still compare before you pay.
      </Text>
    </Animated.View>
  );

  if (variant === 'inline') return card;
  return <View style={styles.column}>{card}</View>;
}

const styles = StyleSheet.create({
  // Same footprint as OrderSummary's column, so swapping the two never
  // moves the page content.
  column: {
    width: 264,
    borderLeftWidth: 1,
    borderLeftColor: colors.border,
    backgroundColor: colors.surface,
    padding: spacing.lg,
  },
  card: { gap: spacing.sm },
  cardInline: {
    backgroundColor: colors.surface,
    borderRadius: radius.lg,
    borderWidth: 1,
    borderColor: '#F6D2B8',
    padding: spacing.lg,
    ...shadow.card,
  },

  topRow: { flexDirection: 'row', alignItems: 'center', justifyContent: 'space-between', gap: spacing.sm },
  badge: {
    flexDirection: 'row',
    alignItems: 'center',
    gap: 4,
    borderWidth: 1,
    borderColor: colors.orange,
    backgroundColor: '#FDF1E6',
    borderRadius: radius.sm,
    paddingHorizontal: 6,
    paddingVertical: 2,
  },
  badgeText: { fontSize: 10, fontWeight: '800', letterSpacing: 0.8, color: colors.orangeDark },
  timer: {
    flexDirection: 'row',
    alignItems: 'center',
    gap: 3,
    backgroundColor: colors.surfaceMuted,
    borderRadius: radius.pill,
    paddingHorizontal: 7,
    paddingVertical: 2,
  },
  timerUrgent: { backgroundColor: '#FCEAE8' },
  timerText: { fontSize: font.xs, fontWeight: '700', color: colors.textMuted },

  image: { width: '100%', aspectRatio: 16 / 9, borderRadius: radius.md, backgroundColor: colors.surfaceMuted },
  imageFallback: {
    width: '100%',
    aspectRatio: 16 / 9,
    borderRadius: radius.md,
    backgroundColor: colors.navy,
    alignItems: 'center',
    justifyContent: 'center',
  },
  monogram: { fontSize: 40, fontWeight: '800', color: colors.onNavy },
  fallbackIcon: { position: 'absolute', right: 10, bottom: 8 },

  shopRow: { flexDirection: 'row', alignItems: 'center', gap: 5, marginTop: 2 },
  shopName: { ...typography.bodyStrong, flexShrink: 1 },
  shopMeta: { ...typography.caption },

  headline: { fontSize: font.lg, fontWeight: '800', color: colors.navy, lineHeight: 22, marginTop: 2 },
  audience: {
    alignSelf: 'flex-start',
    backgroundColor: '#E8EEF8',
    borderRadius: radius.pill,
    paddingHorizontal: spacing.sm,
    paddingVertical: 2,
  },
  audienceText: { fontSize: font.xs, fontWeight: '700', color: colors.navy },
  details: { fontSize: font.sm, color: colors.textMuted, lineHeight: 18 },

  cta: {
    marginTop: spacing.sm,
    flexDirection: 'row',
    alignItems: 'center',
    justifyContent: 'center',
    gap: spacing.sm,
    backgroundColor: colors.orange,
    borderRadius: radius.md,
    paddingVertical: 12,
    paddingHorizontal: spacing.md,
    ...shadow.card,
  },
  ctaPressed: { backgroundColor: colors.orangeDark },
  ctaText: { ...typography.bodyStrong, fontWeight: '700', color: colors.onNavy, textAlign: 'center', flexShrink: 1 },
  link: { alignSelf: 'center', paddingVertical: 2 },
  linkText: { fontSize: font.sm, fontWeight: '700', color: colors.navy },
  fine: { ...typography.caption, fontSize: 11, lineHeight: 15 },
});
