import { useCallback, useEffect, useRef, useState } from 'react';
import { supabase } from '../utils/supabase';

/**
 * The one sponsored deal to show on the dashboard right now, from
 * current_sponsored_deal() (bookshops_sponsored_deals.sql).
 *
 * Null means "nothing to promote" — no live deal, the migration not run,
 * or the request failed. The dashboard treats every one of those the
 * same way: it shows the ordinary Order Summary instead. A promo slot
 * is never worth an error banner.
 */

export interface SponsoredDeal {
  deal_id: string;
  badge: 'SPONSORED' | 'FEATURED DEAL';
  headline: string;
  details: string | null;
  image_url: string | null;
  audience: string | null;
  ends_at: string;
  vendor_id: string;
  store_name: string;
  city: string | null;
  rating: number | null;
  review_count: number;
  verified: boolean;
}

export function useSponsoredDeal() {
  const [deal, setDeal] = useState<SponsoredDeal | null>(null);
  const [loading, setLoading] = useState(true);
  const alive = useRef(true);

  const load = useCallback(async () => {
    const { data, error } = await supabase.rpc('current_sponsored_deal');
    if (!alive.current) return;
    const row = !error && Array.isArray(data) ? data[0] : null;
    setDeal(
      row
        ? {
            ...(row as SponsoredDeal),
            rating: row.rating == null ? null : Number(row.rating),
            review_count: Number(row.review_count ?? 0),
          }
        : null
    );
    setLoading(false);
  }, []);

  useEffect(() => {
    alive.current = true;
    load();
    return () => {
      alive.current = false;
    };
  }, [load]);

  // A deal that runs out while the page is open disappears on time,
  // rather than advertising an offer the shop has stopped honouring.
  useEffect(() => {
    if (!deal) return;
    const ms = new Date(deal.ends_at).getTime() - Date.now();
    if (ms <= 0) {
      load();
      return;
    }
    // setTimeout caps at ~24.8 days; anything longer just waits for the next load.
    if (ms > 2_000_000_000) return;
    const t = setTimeout(load, ms + 1000);
    return () => clearTimeout(t);
  }, [deal, load]);

  return { deal, loading, reload: load };
}

/** "Ends in 3 days", "Ends in 5 hours", "Ends today". */
export function endsInLabel(endsAt: string, now = Date.now()): string {
  const ms = new Date(endsAt).getTime() - now;
  if (ms <= 0) return 'Ended';
  const hours = Math.floor(ms / 3_600_000);
  if (hours < 1) return 'Ends within the hour';
  if (hours < 24) return `Ends in ${hours} hour${hours === 1 ? '' : 's'}`;
  const days = Math.floor(hours / 24);
  return `Ends in ${days} day${days === 1 ? '' : 's'}`;
}
